APP_NAME=LoonInspect
DEBUG=false

DATABASE_URL=sqlite+aiosqlite:///./looninspect.db

# JSON array of allowed frontend origins
CORS_ORIGINS=["http://localhost:5173"]

# Fernet key used to encrypt MDM connection secrets at rest. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Delta events are POSTed here as JSON if set, otherwise logged to stdout
SIEM_WEBHOOK_URL=

SCHEDULER_ENABLED=true
SYNC_HOUR=1
SYNC_MINUTE=0
SYNC_TIMEZONE=America/Chicago
