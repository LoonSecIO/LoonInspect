APP_NAME=LoonInspect
DEBUG=false

# --- Database ------------------------------------------------------------------
# Postgres only; SQLite was retired in #29. docker compose builds DATABASE_URL from
# POSTGRES_APP_PASSWORD below and points it at the bundled `db` service, so this line
# is only for running the backend directly against a Postgres of your own.
DATABASE_URL=postgresql+asyncpg://looninspect_app:CHANGE_ME@localhost:5432/looninspect

# Two roles, on purpose. POSTGRES_PASSWORD is the bootstrap superuser, used to create
# the database and nothing else. POSTGRES_APP_PASSWORD belongs to looninspect_app,
# which the application actually connects as and which is deliberately *not* a
# superuser — a superuser bypasses row-level security without a word, so connecting
# as one would leave tenant isolation attached and enforcing nothing.
#
# Generate both with:
#   openssl rand -hex 32
# Hex rather than base64 because this ends up inside a URL; a '@' or '/' in the
# password silently truncates the connection string instead of failing.
#
# Both are read once, when the database volume is first created. Changing them later
# does not rotate anything — do that with ALTER ROLE, or remove the volume.
POSTGRES_PASSWORD=
POSTGRES_APP_PASSWORD=

# bundled | external. Only 'bundled' is shipped in v0; 'external' is a named seam that
# refuses to start rather than half-working.
DATABASE_MODE=bundled

# JSON array of allowed frontend origins
CORS_ORIGINS=["http://localhost:5173"]

# Fernet key used to encrypt MDM connection secrets at rest. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Delta events are POSTed here as JSON if set, otherwise logged to stdout
SIEM_WEBHOOK_URL=

# First-run administrator. Leave both blank to use the interactive setup wizard
# instead (a claim token is printed to `docker compose logs` on first boot). Set both
# to skip the wizard and have this account created automatically — useful for
# scripted/CI deployments. Password must be at least 12 characters.
# Skipping the wizard also skips its community-data-sharing question, so sharing stays
# off on this path until an administrator opts in (docs/data-sharing.md).
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

SCHEDULER_ENABLED=true
SYNC_HOUR=1
SYNC_MINUTE=0
SYNC_TIMEZONE=America/Chicago

# --- TLS -----------------------------------------------------------------------
# off          plain HTTP (default)
# self-signed  generate a certificate on first boot and persist it on the data volume
# provided     serve from a mounted certificate and key
# Self-signed is for the load-balancer-to-container hop: it lets you answer "TLS all
# the way to the application" without a public CA. Nothing that validates chains will
# trust it — use `provided` for that.
TLS_MODE=off
TLS_HOSTNAME=localhost
TLS_CERT_PATH=./data/certs/server.crt
TLS_KEY_PATH=./data/certs/server.key

# Whose X-Forwarded-For headers are trusted. Left at localhost, a reverse proxy's own
# address is what lands in the audit log instead of the real client's. Set this to the
# proxy's address once one is in front.
FORWARDED_ALLOW_IPS=127.0.0.1

# Marks the session cookie Secure. Browsers drop Secure cookies over plain HTTP on any
# hostname other than localhost, so leaving this on while serving HTTP off-localhost
# breaks sign-in silently. Only set false for a deliberate plain-HTTP deployment.
SECURE_COOKIES=true

# Whether an MDM connection's URL may be plain http. Off by default: the Jamf
# client-credentials exchange puts the client secret in the request body, so http hands
# it to anything on the path. https is also the only scheme a Jamf Cloud tenant speaks;
# turn this on only for a lab Jamf Pro on your own network. Address rules are unaffected
# either way — loopback and link-local (169.254.169.254) stay refused. See
# backend/app/core/egress.py.
ALLOW_INSECURE_MDM_BASE_URL=false
